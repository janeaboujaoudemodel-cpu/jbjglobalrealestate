    "check:contrast:architecture": "node scripts/contrast/check-contrast-architecture.mjs",
    "check:contrast:pr-gate": "npm run check:contrast:architecture && npm run check:contrast:tokens && npm run check:contrast:faded-gold && npm run check:contrast:low-opacity && npm run check:contrast:white-on-light && npm run check:contrast:black-on-dark && npm run check:contrast:same-tone && npm run check:contrast:interactive",
    "check:contrast": "npm run check:contrast:architecture && npm run check:contrast:tokens && npm run check:contrast:white-on-light && npm run check:contrast:black-on-dark && npm run check:contrast:low-opacity && npm run check:contrast:faded-gold && npm run check:contrast:same-tone && npm run check:contrast:interactive && npm run check:contrast:rendered",
    "check:a11y:static": "node scripts/a11y/check-static-aria.mjs",
    "check:a11y:aria": "node scripts/a11y/check-aria.mjs",
    "check:a11y:keyboard": "node scripts/a11y/check-keyboard.mjs",
    "check:a11y": "npm run check:a11y:static && npm run check:a11y:aria && npm run check:a11y:keyboard",
    "check:quality": "npm run check:contrast && npm run check:a11y",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "src/index.css": "node scripts/contrast/check-tokens.mjs",
    "tailwind.config.ts": "node scripts/contrast/check-tokens.mjs",
    "src/**/*.{tsx,jsx}": [
