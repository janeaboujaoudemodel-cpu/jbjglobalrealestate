# ===========================================
# JBJ Global Real Estate — Environment Config
# ===========================================
# Copy this file to .env and fill in your values.
#
# `.env` and `.env.*` are gitignored — only this example file is tracked. The
# real values live in Lovable's env config (frontend) and `supabase secrets
# set` (edge functions); nothing below belongs in a commit.

# ── Frontend (Vite) ──────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Error monitoring (Sentry). Optional — if unset, error monitoring is
# fully disabled and nothing is sent anywhere (see src/lib/sentry.ts).
# Get this from Sentry: Settings → Projects → <project> → Client Keys (DSN).
VITE_SENTRY_DSN=

# Stripe publishable key for the payments UI. Publishable (`pk_test_` /
# `pk_live_`) only — the secret key is an edge-function secret and must never
# be a VITE_ variable. Unset disables payments (see src/lib/stripe.ts).
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_xxxx

# ── Edge Function Secrets ────────────────────
# Set these via: supabase secrets set KEY=value
RESEND_API_KEY=re_xxxx
REELLY_API_KEY=xxxx
BREVO_API_KEY=xxxx
BREVO_LIST_ID=xxxx
OWNER_EMAIL=owner@example.com
LEAD_REF_HMAC_KEY=xxxx
PERPLEXITY_API_KEY=pplx-xxxx
VAPI_API_KEY=xxxx
ELEVENLABS_API_KEY=xxxx
ELEVENLABS_AGENT_ID=xxxx
ELEVENLABS_VOICE_ID=xxxx
FIRECRAWL_API_KEY=xxxx
