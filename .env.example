# ===========================================
# JBJ Global Real Estate — Environment Config
# ===========================================
# Copy this file to .env and fill in your values.

# ── Frontend (Vite) ──────────────────────────
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
VITE_SUPABASE_PROJECT_ID=your-project-id

# Error monitoring (Sentry). Optional — if unset, error monitoring is
# fully disabled and nothing is sent anywhere (see src/lib/sentry.ts).
# Get this from Sentry: Settings → Projects → <project> → Client Keys (DSN).
VITE_SENTRY_DSN=

# Stripe publishable key, surfaced to the browser. The prefix is what selects
# the payments environment at runtime (src/lib/stripe.ts): `pk_test_` → sandbox,
# `pk_live_` → live. Anything else disables checkout entirely.
VITE_PAYMENTS_CLIENT_TOKEN=pk_test_xxxx

# ── Edge Function Secrets ────────────────────
# Set these via: supabase secrets set KEY=value
RESEND_API_KEY=re_xxxx
REELLY_API_KEY=xxxx
BREVO_API_KEY=xxxx
BREVO_LIST_ID=xxxx
OWNER_EMAIL=owner@example.com
LEAD_REF_HMAC_KEY=xxxx
PERPLEXITY_API_KEY=pplx-xxxx
VAPI_API_KEY=xxxx
ELEVENLABS_API_KEY=xxxx
ELEVENLABS_AGENT_ID=xxxx
ELEVENLABS_VOICE_ID=xxxx
FIRECRAWL_API_KEY=xxxx

# ── Stripe / Payments (edge-function secrets) ─────
# Set via: supabase secrets set KEY=value
# Sandbox and live are kept as separate key pairs; the webhook endpoint picks
# which pair to use from its `?env=sandbox|live` query param, and
# create-checkout / create-portal-session from the request's `environment`.
# NEVER put a secret key in a VITE_* variable — those are bundled into the
# browser build.
STRIPE_SANDBOX_API_KEY=sk_test_xxxx
STRIPE_LIVE_API_KEY=sk_live_xxxx
PAYMENTS_SANDBOX_WEBHOOK_SECRET=whsec_xxxx
PAYMENTS_LIVE_WEBHOOK_SECRET=whsec_xxxx
# Stripe API calls are proxied through Lovable's connector gateway
# (supabase/functions/_shared/stripe.ts), which authenticates with this key.
LOVABLE_API_KEY=xxxx
